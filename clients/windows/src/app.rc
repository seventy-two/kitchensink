    BEGIN
        BLOCK "080904b0"
        BEGIN
            VALUE "FileDescription", "kitchensink dashboard"
            VALUE "ProductName", "kitchensink"
            VALUE "FileVersion", "1.0.0"
            VALUE "ProductVersion", "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x809, 1200
    END
END
