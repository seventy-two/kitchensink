{
  "listen": "127.0.0.1:6030",
  "database": "kitchensink.db",
  "token": "${KITCHENSINK_TOKEN}",
  "notifiers": [],
  "monitors": [
    {
      "type": "calendar",
      "title": "Calendar",
      "interval": "15m",
      "config": {
        "calendars": [
          { "name": "Work", "url": "${WORK_CALENDAR_URL}", "tone": "accent" },
          { "name": "Personal", "url": "${PERSONAL_CALENDAR_URL}", "tone": "good" }
        ],
        "timezone": "Europe/London",
        "days": 7,
        "remindMinutes": 10,
        "explain": { "apiKey": "${GEMINI_API_KEY}", "context": "Lives in London and cycles to work." }
      }
    },
    {
      "type": "todo",
      "title": "To do",
      "interval": "1h"
    },
    {
      "type": "chores",
      "title": "Chores",
      "interval": "6h",
      "config": {
        "timezone": "Europe/London",
        "remindAt": "08:00",
        "perDay": { "washer": 1 },
        "chores": [
          { "name": "Towel wash", "every": 7, "uses": "washer" },
          { "name": "Bedsheet wash", "every": 14, "flex": 3, "days": ["Sat", "Sun"], "uses": "washer" },
          { "name": "Bins out", "every": 7, "flex": 0, "days": ["Thu"] },
          { "name": "Weekly shop", "every": 7 }
        ]
      }
    },
    {
      "type": "dailies",
      "title": "Dailies",
      "interval": "10m",
      "config": { "url": "http://127.0.0.1:6040", "player": "M", "versus": "J", "names": { "wordle": "W" } }
    },
    {
      "type": "letterboxd",
      "title": "Letterboxd",
      "interval": "1h",
      "config": { "user": "someone", "local": "watchgrab" }
    },
    {
      "type": "osrs",
      "title": "OSRS today",
      "interval": "1h",
      "config": { "player": "Zezima", "hookSecret": "${OSRS_HOOK_SECRET}" }
    },
    {
      "type": "mail",
      "title": "Mail",
      "interval": "10m",
      "config": {
        "accounts": [
          { "type": "imap", "name": "Gmail", "user": "${GMAIL_USER}", "password": "${GMAIL_APP_PASSWORD}" },
          { "type": "outlook", "name": "Outlook", "clientId": "${OUTLOOK_CLIENT_ID}" }
        ],
        "gemini": { "apiKey": "${GEMINI_API_KEY}", "context": "Lives in London with their partner." },
        "choresDone": { "weekly-shop": "a supermarket groceries order being placed" }
      }
    },
    {
      "type": "stocks",
      "title": "Watchlist",
      "interval": "5m",
      "config": {
        "symbols": ["AAPL", "TSLA", ".FTSE", "BTC.CM="],
        "holdings": ["AAPL", "TSLA"],
        "movePct": 5,
        "targets": { "AAPL": { "above": 350, "below": 300 } }
      }
    },
    {
      "type": "football",
      "title": "Football",
      "interval": "5m",
      "config": {
        "nfl": { "teams": ["CHI"], "timezone": "Europe/London" },
        "fantasy": {
          "sleeperUser": "your-sleeper-name",
          "espn": [{ "leagueId": "123456", "s2": "${ESPN_S2}", "swid": "${ESPN_SWID}" }],
          "names": { "123456": "Work" }
        },
        "games": 4
      }
    },
    {
      "type": "weather",
      "title": "Weather",
      "interval": "15m",
      "config": {
        "place": "London",
        "latitude": 51.5072,
        "longitude": -0.1276,
        "timezone": "Europe/London",
        "frostC": 0
      }
    },
    {
      "type": "autotrader",
      "title": "AutoTrader",
      "interval": "2h",
      "config": { "searchURL": "${AUTOTRADER_SEARCH_URL}" }
    }
  ]
}
